# Application Configuration
APP_TIMEZONE=UTC

# Spring Profile (default: prod)
# Options: prod | dev | test
# - dev: Enables debug logging, request/response logging, SQL logging
# - test: Uses test configuration and fixed clock
# - prod: Production configuration (default)
# To run with dev profile: mvn spring-boot:run -Dspring-boot.run.profiles=dev
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/kidsgptdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=bestuser
DB_PASSWORD=bestuser

# Database Schema Management (Hibernate DDL Auto)
# Options: none | validate | update | create | create-drop
# - create-drop: DELETES ALL DATA on startup (only for local testing)
# - update: Updates schema, preserves data (good for dev/staging)
# - validate: Only validates, no changes (recommended for production)
# - none: No schema management (use with Flyway/Liquibase)
DDL_AUTO=update

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Docker Configuration (for docker-compose)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=bestuser
MYSQL_PASSWORD=bestuser
DOCKER_USER=your-docker-username
APP_TAG=latest

# Verification settings
VERIFICATION_PEPPER=base64-encoded-pepper-key-here
VERIFICATION_TTL_MINUTES=30

# Google Play API Configuration
# Option 1: Service account key JSON content (paste entire JSON as single-line string)
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
# Option 2: Path to service account credentials JSON file (takes precedence if both set)
# Example: /path/to/google-play-credentials.json
GOOGLE_PLAY_CREDENTIALS_FILE=
# Your Android app package name
GOOGLE_PLAY_PACKAGE_NAME=uk.gegc.kidsgpt
# Application name for API requests
GOOGLE_PLAY_APPLICATION_NAME=KidsGPT
# Webhook audience for JWT verification (your Cloud Pub/Sub subscription name)
GOOGLE_PLAY_WEBHOOK_AUDIENCE=